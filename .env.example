PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/deskshare

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Firebase Admin SDK
# If FIREBASE_STORAGE_BUCKET is omitted or left as a placeholder, it is derived
# automatically as <FIREBASE_PROJECT_ID>.firebasestorage.app. The matching bucket
# must exist in Firebase Console (Storage) for uploads to go to Firebase.
# When Firebase is unavailable, image uploads automatically fall back to local
# disk storage under public/uploads and are served from /uploads/<file>.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-your-id@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
